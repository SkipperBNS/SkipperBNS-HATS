{
  "pack_name": "SkipperBNS HATS",
  "version": "1.0.0",
  "components": [
    {
      "name": "HATS Base",
      "repo": "sthetix/HATS",
      "asset_regex": "(?i)^HATS.*\\.zip$",
      "mode": "hats_base"
    },
    {
      "name": "Atmosphere",
      "repo": "Atmosphere-NX/Atmosphere",
      "asset_regex": "^atmosphere-.*\\.zip$",
      "mode": "zip"
    },
    {
      "name": "Hekate + Nyx",
      "repo": "CTCaer/hekate",
      "asset_regex": "^hekate_ctcaer_.*\\.zip$",
      "mode": "zip"
    },
    {
      "name": "Custom Hekate Background",
      "mode": "local_root",
      "source": "assets/background.bmp",
      "destination": "bootloader/res/background.bmp"
    },
    {
      "name": "JKSV",
      "repo": "J-D-K/JKSV",
      "asset_regex": "^JKSV\\.nro$",
      "mode": "nro",
      "destination": "switch/JKSV.nro"
    },
    {
      "name": "Goldleaf",
      "repo": "XorTroll/Goldleaf",
      "asset_regex": "^Goldleaf\\.nro$",
      "mode": "nro",
      "destination": "switch/Goldleaf.nro"
    },
    {
      "name": "NXThemesInstaller",
      "repo": "exelix11/SwitchThemeInjector",
      "asset_regex": "^NXThemesInstaller\\.nro$",
      "mode": "nro",
      "destination": "switch/NXThemesInstaller.nro"
    },
    {
      "name": "HATS-Tools",
      "repo": "sthetix/HATS-Tools",
      "asset_regex": ".*\\.zip$",
      "mode": "zip"
    },
    {
      "name": "Sphaira",
      "repo": "ITotalJustice/sphaira",
      "asset_regex": "^sphaira\\.zip$",
      "mode": "zip"
    },
    {
      "name": "Switch 90DNS Tester",
      "repo": "meganukebmp/Switch_90DNS_tester",
      "asset_regex": ".*\\.nro$",
      "mode": "nro",
      "destination": "switch/90DNSTester.nro"
    },
    {
      "name": "Tinwoo Installer",
      "repo": "mrdude2478/Tinwoo-Release",
      "asset_regex": "^Tinwoo-Installer\\.zip$",
      "mode": "zip"
    },
    {
      "name": "Linkalho",
      "repo": "impeeza/linkalho",
      "asset_regex": "^linkalho-.*\\.zip$",
      "mode": "zip"
    },
    {
      "name": "MissionControl",
      "repo": "ndeadly/MissionControl",
      "asset_regex": ".*\\.zip$",
      "mode": "zip"
    },
    {
      "name": "SaltyNX",
      "repo": "masagrator/SaltyNX",
      "asset_regex": ".*\\.zip$",
      "mode": "zip"
    },
    {
      "name": "nx-ovlloader",
      "repo": "ppkantorski/nx-ovlloader",
      "asset_regex": ".*\\.zip$",
      "mode": "zip"
    },
    {
      "name": "EdiZon Overlay",
      "repo": "proferabg/EdiZon-Overlay",
      "asset_regex": ".*\\.ovl$",
      "mode": "ovl",
      "destination": "switch/.overlays/EdiZon.ovl"
    },
    {
      "name": "FPSLocker",
      "repo": "masagrator/FPSLocker",
      "asset_regex": ".*\\.ovl$",
      "mode": "ovl",
      "destination": "switch/.overlays/FPSLocker.ovl"
    },
    {
      "name": "QuickNTP",
      "repo": "nedex/QuickNTP",
      "asset_regex": "^quickntp-.*\\.zip$",
      "mode": "zip"
    },
    {
      "name": "Status Monitor Overlay",
      "repo": "masagrator/Status-Monitor-Overlay",
      "asset_regex": "^Status-Monitor-Overlay\\.zip$",
      "mode": "zip"
    },
    {
      "name": "Sysmodules Overlay",
      "repo": "ppkantorski/ovl-sysmodules",
      "asset_regex": "^ovlSysmodules\\.ovl$",
      "mode": "ovl",
      "destination": "switch/.overlays/ovlSysmodules.ovl"
    },
    {
      "name": "Ultrahand Overlay",
      "repo": "ppkantorski/Ultrahand-Overlay",
      "asset_regex": ".*\\.ovl$",
      "mode": "ovl",
      "destination": "switch/.overlays/ovlmenu.ovl"
    },
    {
      "name": "emuiibo",
      "repo": "XorTroll/emuiibo",
      "asset_regex": "^emuiibo\\.zip$",
      "mode": "zip"
    },
    {
      "name": "sys-clk Overlay",
      "repo": "ppkantorski/sys-clk",
      "asset_regex": "^sys-clk-overlay\\.ovl$",
      "mode": "ovl",
      "destination": "switch/.overlays/sys-clk-overlay.ovl"
    },
    {
      "name": "ftpd",
      "mode": "local_root",
      "source": "ftpd.nro",
      "destination": "switch/ftpd.nro"
    },
    {
      "name": "Checkpoint",
      "mode": "local_root",
      "source": "checkpoint.nro",
      "destination": "switch/checkpoint.nro"
    }
  ]
}
