      "mode": "nro",
      "destination": "switch/Tinwoo.nro"
    },
    {
      "name": "Linkalho",
      "repo": "impeeza/linkalho",
      "asset_regex": ".*\\.nro$",
      "mode": "nro",
      "destination": "switch/linkalho.nro"
